{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "./e2e/**",
      "!**/.artifacts",
      "./src/**",
      "./tests/**",
      "./biome.json",
      "./db.Dockerfile",
      "./docker-compose.yml",
      "./drizzle.config.ts",
      "./next.config.ts",
      "./package.json",
      "./playwright.config.ts",
      "./postcss.config.mjs",
      "./tsconfig.json",
      "./web.Dockerfile"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useMediaCaption": "off"
      },
      "correctness": {
        "noChildrenProp": "off",
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "style": {
        "useBlockStatements": "warn",
        "noParameterAssign": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["./e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentWidth": 2,
    "indentStyle": "space",
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
