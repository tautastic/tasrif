    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "When the middle vowel of the perfective is " },
        { "type": "italic", "value": "a" },
        { "type": "text", "value": ", the middle vowel of the imperfective may be " },
        { "type": "italic", "value": "a" },
        { "type": "text", "value": ", " },
        { "type": "italic", "value": "i" },
        { "type": "text", "value": ", or " },
        { "type": "italic", "value": "u" },
        { "type": "text", "value": ". When the perfective vowel is " },
        { "type": "italic", "value": "i" },
        { "type": "text", "value": ", the imperfective vowel is usually " },
        { "type": "italic", "value": "a" },
        { "type": "text", "value": "; when the perfective vowel is " },
        { "type": "italic", "value": "u" },
        { "type": "text", "value": ", the imperfective vowel is also " },
        { "type": "italic", "value": "u" },
        { "type": "text", "value": "." }
      ]
    },
