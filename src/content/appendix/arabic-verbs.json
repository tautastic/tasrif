      "items": [
        [
          {
            "type": "ref",
            "arabic": "قَتَلَ",
            "transliteration": "qatala",
            "gloss": "to kill",
            "literal": "he killed"
          }
        ],
        [
          {
            "type": "ref",
            "arabic": "سَلِمَ",
            "transliteration": "salima",
