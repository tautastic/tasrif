    {
      "type": "heading",
      "title": "Form II"
    },
    {
      "type": "mainCategory",
      "href": "arabic-verbs/form/2",
      "label": "Arabic form-II verbs"
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "Perfective " },
        { "type": "ref", "arabic": "فَعَّلَ", "href": null, "transliteration": "faʕʕala" },
        { "type": "text", "value": ", imperfective " },
        { "type": "ref", "arabic": "يُفَعِّلُ", "href": null, "transliteration": "yufaʕʕilu" },
        { "type": "text", "value": ", verbal noun generally " },
        { "type": "ref", "arabic": "تَفْعِيل", "href": null, "transliteration": "tafʕīl" },
        { "type": "text", "value": ", in weak verbs necessarily and final-hamzated verbs facultatively " },
        { "type": "ref", "arabic": "تَفْعِلَة", "href": null, "transliteration": "tafʕila" },
        { "type": "text", "value": ", with geminate verbs sometimes " },
        { "type": "ref", "arabic": "تَفْعَال", "href": null, "transliteration": "tafʕāl" },
        { "type": "text", "value": ", in rare historical cases a " },
        { "type": "ref", "arabic": "فِعَّال", "href": null, "transliteration": "fiʕʕāl" },
        { "type": "text", "value": " verbal noun exists, active participle " },
        { "type": "ref", "arabic": "مُفَعِّل", "href": null, "transliteration": "mufaʕʕil" },
        { "type": "text", "value": ", passive participle " },
        { "type": "ref", "arabic": "مُفَعَّل", "href": null, "transliteration": "mufaʕʕal" },
        { "type": "text", "value": ", imperative (2nd person, m, sg) " },
        { "type": "ref", "arabic": "فَعِّلْ", "href": null, "transliteration": "faʕʕil" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "This stem is formed by doubling the second radical. The meaning this form imparts is intensive or extensive, causative, declarative, or denominative."
        }
      ]
    },
    {
      "type": "meaningList",
      "items": [
        {
          "label": "Intensive",
          "arabic": "لِلْمُبَالَغَة",
          "transliteration": "lilmubālaḡa",
          "description": "the action of the base verb performed with great violence or force:",
