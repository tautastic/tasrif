                "arabic": "ظَمَّأَ",
                "transliteration": "ẓammaʔa",
                "gloss": "to make thirsty",
                "cf": { "type": "ref", "arabic": "ظَمِئَ", "transliteration": "ẓamiʔa", "gloss": "to be thirsty" }
              }
