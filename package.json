{
  "name": "tasrif",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm exec biome check ./",
    "check:write": "pnpm exec biome check --write --unsafe ./",
    "db:start": "docker/db/dev.sh start",
    "db:stop": "docker/db/dev.sh stop",
    "db:reset": "docker/db/dev.sh reset",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:build": "PGHOST=build PGUSER=build PGDATABASE=build AUTH_PASSWORD=build-only-password AUTH_SECRET=build-only-secret-build-only-secret next build && playwright test",
    "e2e:fast": "playwright test --grep-invert @slow",
    "preview": "next build && next start",
    "start": "next start",
    "test": "node --import ./tests/harness/register.ts --test \"tests/**/*.test.ts\"",
    "test:one": "node --import ./tests/harness/register.ts --test",
    "test:corpus": "CORPUS=1 node --import ./tests/harness/register.ts --test \"tests/corpus/**/*.test.ts\"",
    "test:db:stop": "docker rm -f tasrif-test-pg",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.11.0"
  }
}
